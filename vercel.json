{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -- --mode demo",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/resources/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "sandbox allow-scripts allow-forms allow-popups" }
      ]
    }
  ]
}
